# BroadcastBrain environment overrides.
# Copy to `.env` (or export these) -- they take precedence over the TOML file.
# Nested keys use a double underscore: [workers] cpu_workers -> BB_WORKERS__CPU_WORKERS

# --- where things live -------------------------------------------------------
BB_PATHS__ROOT=/Volumes/Archive/BroadcastBrain
# BB_CONFIG=/etc/broadcastbrain/broadcastbrain.toml

# --- concurrency -------------------------------------------------------------
# BB_WORKERS__CPU_WORKERS=8          # 0 or unset = auto (cores - 1)
# BB_WORKERS__GPU_WORKERS=1
# BB_WORKERS__LOW_MEMORY=true
# BB_WORKERS__MIN_FREE_GB=50

# --- models ------------------------------------------------------------------
# BB_ANALYSIS__WHISPER_MODEL=small.en
# BB_ANALYSIS__WHISPER_DEVICE=cuda
# BB_ANALYSIS__FACES_GALLERY=/srv/faces        # <gallery>/<Person Name>/*.jpg

# --- segmentation ------------------------------------------------------------
# BB_SEGMENTATION__MIN_BOUNDARY_SCORE=0.9      # lower = cut more aggressively
# BB_SEGMENTATION__REENCODE=true               # frame-accurate cuts, much slower

# --- database ----------------------------------------------------------------
# BB_DATABASE__URL=postgresql+psycopg://user:pass@localhost/broadcastbrain

# --- secrets (deliberately not stored in the TOML file) ----------------------
# BB_ACOUSTID_API_KEY=your-key-here            # enables music identification
